{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sobes plugin marketplace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "displayName", "categories", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string" },
    "displayName": { "$ref": "#/$defs/localized" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": { "id": { "type": "string" }, "title": { "$ref": "#/$defs/localized" } }
      }
    },
    "plugins": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "localizedMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "en": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "category",
        "keywords",
        "updatedAt",
        "manifest",
        "source",
        "sha256",
        "changelog"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "publisher": { "type": "string" },
        "category": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" },
        "manifest": {
          "type": "object",
          "required": ["id", "version", "apiVersion", "permissions"],
          "properties": { "apiVersion": { "const": 1 } }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "changelog": { "$ref": "#/$defs/localized" },
        "overview": { "$ref": "#/$defs/localizedMarkdown" },
        "repository": { "type": "string", "format": "uri", "maxLength": 2048 },
        "screenshots": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "caption": { "$ref": "#/$defs/localized" }
            }
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "repository", "revision", "path"],
              "properties": {
                "type": { "const": "github" },
                "repository": { "type": "string" },
                "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "path": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "repository", "tag", "asset"],
              "properties": {
                "type": { "const": "release" },
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "asset": { "type": "string" }
              }
            }
          ]
        }
      }
    }
  }
}
